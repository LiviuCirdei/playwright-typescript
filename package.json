{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headless": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project 'chromium'",
    "test:firefox": "npx playwright test --project='firefox'",
    "test:webkit": "npx playwright test --project='webkit'",
    "test:report": "npx playwright show-report",
    "test:ui": "npx playwright test --ui",
    "debug": "npx playwright test --debug",
    "codegen": "npx playwright codegen",
    "playwright:update": "npm install -D @playwright/test@latest && npx playwright install --with-deps",
    "playwright:version": "npx playwright --version",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiviuCirdei/playwright-typescript.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "end-to-end-testing",
    "test-automation"
  ],
  "author": "Liviu Cirdei",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LiviuCirdei/playwright-typescript/issues"
  },
  "homepage": "https://github.com/LiviuCirdei/playwright-typescript#readme",
  "description": "End-to-end checkout automation for Sauce Demo using Playwright and TypeScript.",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
